{
	"name": "agencecinq/cinq-wp-central",
	"description": "L'espace client CINQ dans l'administration WordPress, au fil de Central.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "CINQ",
			"email": "contact@agencecinq.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2"
	},
	"autoload": {
		"psr-4": {
			"CinqWpCentral\\": "./includes"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "php tests/run-tests.php",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"homepage": "https://github.com/agencecinq/cinq-wp-central"
}
